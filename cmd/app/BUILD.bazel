load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "app_lib",
    srcs = ["main.go"],
    importpath = "webapp/cmd/app",
    visibility = ["//visibility:private"],
    deps = ["@com_github_maxence_charriere_go_app_v9//pkg/app:go_default_library"],
)

go_binary(
    name = "app.wasm",
    embed = [":app_lib"],
    goarch = "wasm",
    goos = "js",
    visibility = ["//visibility:public"],
)

go_binary(
    name = "server",
    args = [
        "--wasm-path=$(location :app.wasm)",
    ],
    data = [":app.wasm"],
    embed = [":app_lib"],
    visibility = ["//visibility:public"],
)
