load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "app_lib",
    srcs = ["main.go"],
    importpath = "webapp/cmd/app",
    visibility = ["//visibility:private"],
    deps = ["@com_github_maxence_charriere_go_app_v9//pkg/app:go_default_library"],
)

go_binary(
    name = "app.wasm",
    srcs = ["main_wasm.go"],
    embed = [":app_lib"],
    goarch = "wasm",
    goos = "js",
    visibility = ["//visibility:public"],
)

genrule(
    name = "bundle_wasm",
    srcs = [":app.wasm"],
    outs = ["app_bundled.wasm"],
    cmd = "cp $(location :app.wasm) $@",
)

go_binary(
    name = "server",
    srcs = ["main_server.go"],
    embed = [":app_lib"],
    embedsrcs = [":app_bundled.wasm"],
    visibility = ["//visibility:public"],
)
